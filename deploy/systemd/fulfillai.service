[Unit]
Description=FulfillAI FastAPI Service
After=network.target

[Service]
Type=simple
User=fulfillai
Group=fulfillai
WorkingDirectory=/opt/fulfillai/app
Environment=PYTHONUNBUFFERED=1

ExecStart=/opt/fulfillai/venv/bin/uvicorn src.fulfillai.api.main:app --host 127.0.0.1 --port 8000

Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
